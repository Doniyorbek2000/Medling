# Faqat ishlab chiqish uchun namuna. Haqiqiy qiymatlarni Secret Manager'da saqlang.
MEDLINK_ENV=dev
PORT=8080
# openssl rand -base64 48
MEDLINK_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# openssl rand -base64 32  (format: keyId:base64, vergul bilan bir nechta kalit)
MEDLINK_DATA_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
MEDLINK_ACTIVE_KEY_ID=k1
MEDLINK_ADMIN_PHONES=+998900000001

# Google Cloud Vertex AI (Med-PaLM 2 / MedLM)
GCP_PROJECT=your-gcp-project
GCP_LOCATION=us-central1
MEDLINK_MED_MODEL=medlm-large
# Lokal: GCP_ACCESS_TOKEN=$(gcloud auth print-access-token)

# Click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Payme
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=true

# Google Pay / Apple Pay (xalqaro ekvayer)
STRIPE_SECRET_KEY=
