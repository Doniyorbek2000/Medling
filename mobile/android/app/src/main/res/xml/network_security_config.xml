<?xml version="1.0" encoding="utf-8"?>
<!-- Release: faqat HTTPS, faqat tizim sertifikatlari (foydalanuvchi o'rnatgan
     CA'larga ishonilmaydi — MITM proksi orqali trafikni o'qib bo'lmaydi). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
